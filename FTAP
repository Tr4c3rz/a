local function isWhitelisted(targetPlayer)
    if targetPlayer == player then
        return true
    end

    if Flags.WhitelistFriends and player:IsFriendsWith(targetPlayer.UserId) then
        return true
    end

    if manualWhitelist[targetPlayer.UserId] then
        return true
    end

    return false
end

local function findTargetPlayer(searchString)
    searchString = string.lower(searchString)

    for _, p in ipairs(Players:GetPlayers()) do
        if string.find(string.lower(p.Name), searchString)
            or string.find(string.lower(p.DisplayName), searchString) then
            return p
        end
    end

    return nil
end

local function refreshBringQueue()
    table.clear(bringQueue)

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and not isWhitelisted(p) and p.Character then
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")

            if root and hum and hum.Health > 0 then
                table.insert(bringQueue, p)
            end
        end
    end
end

local function runBringAllLogic()
    if not player.Character
        or not player.Character:FindFirstChild("HumanoidRootPart") then
        return
    end

    local savedCamCFrame = camera.CFrame

    camera.CameraType = Enum.CameraType.Scriptable
    camera.CFrame = savedCamCFrame

    local savedPosBring = player.Character.HumanoidRootPart.Position

    refreshBringQueue()

    if #bringQueue == 0 then 
        camera.CameraType = Enum.CameraType.Custom

        Window:Notify({
            title = "Bring Error",
            content = "No valid targets found.",
            duration = 3
        })

        return 
    end

    local successfullyBrought = {}

    while #bringQueue > 0 do
        local target = bringQueue[1]
        table.remove(bringQueue, 1)

        if target and target.Character and player.Character then
            local root = target.Character:FindFirstChild("HumanoidRootPart")
            local localRoot = player.Character:FindFirstChild("HumanoidRootPart")

            if root and localRoot then
                pcall(function()
                    player.Character:PivotTo(
                        root.CFrame * CFrame.new(0, -5.8, 0)
                    )
                end)

                disableCollisionsBring(player.Character)

                task.wait(0.105)

                if networkOwnerRemote then
                    pcall(function()
                        networkOwnerRemote:FireServer(
                            root,
                            localRoot.CFrame
                        )
                    end)

                    task.wait(0.03)

                    pcall(function()
                        networkOwnerRemote:FireServer(
                            root,
                            localRoot.CFrame
                        )
                    end)
                end

                task.wait(0.07)

                pcall(function()
                    root.CFrame = CFrame.new(savedPosBring)
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                end)

                task.wait(0.05)

                if root
                    and (root.Position - savedPosBring).Magnitude <= 20 then
                    table.insert(
                        successfullyBrought,
                        target.DisplayName or target.Name
                    )
                end
            end
        end
    end

    if player.Character
        and player.Character:FindFirstChild("HumanoidRootPart") then

        pcall(function()
            player.Character.HumanoidRootPart.CFrame =
                CFrame.new(savedPosBring + Vector3.new(0, 2.5, 0))
        end)
    end

    camera.CameraType = Enum.CameraType.Custom

    Window:Notify({
        title = "Bring All Status",
        content = #successfullyBrought > 0
            and "Brought: " .. table.concat(successfullyBrought, ", ")
            or "Targets failed validation.",
        duration = 4
    })
end

local function bringSinglePlayer(target)
    if not target or not target.Character or not player.Character then
        return
    end

    if not player.Character:FindFirstChild("HumanoidRootPart") then
        return
    end

    local savedPos = player.Character.HumanoidRootPart.Position
    local root = target.Character:FindFirstChild("HumanoidRootPart")
    local localRoot = player.Character:FindFirstChild("HumanoidRootPart")

    if root and localRoot then
        pcall(function()
            player.Character:PivotTo(
                root.CFrame * CFrame.new(0, -5.8, 0)
            )
        end)

        disableCollisionsBring(player.Character)

        task.wait(0.105)

        if networkOwnerRemote then
            pcall(function()
                networkOwnerRemote:FireServer(
                    root,
                    localRoot.CFrame
                )
            end)

            task.wait(0.03)

            pcall(function()
                networkOwnerRemote:FireServer(
                    root,
                    localRoot.CFrame
                )
            end)
        end

        task.wait(0.07)

        pcall(function()
            root.CFrame = CFrame.new(savedPos)
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)

        task.wait(0.05)

        local passed =
            root and
            (root.Position - savedPos).Magnitude <= 20

        if player.Character
            and player.Character:FindFirstChild("HumanoidRootPart") then

            pcall(function()
                player.Character.HumanoidRootPart.CFrame =
                    CFrame.new(savedPos + Vector3.new(0, 2.5, 0))
            end)
        end

        Window:Notify({
            title = passed and "Bring Complete" or "Verification Failed",
            content = passed
                and "Successfully brought " .. tostring(target.DisplayName)
                or tostring(target.DisplayName) .. " snapped back.",
            duration = 3
        })
    end
end

local function smoothMoveTo(mover, targetPos, duration)
    duration = duration or 0.04

    local tweenInfo = TweenInfo.new(
        duration,
        Enum.EasingStyle.Linear,
        Enum.EasingDirection.Out
    )

    local tween = TweenService:Create(mover, tweenInfo, {
        Position = targetPos
    })

    tween:Play()

    return tween
end


