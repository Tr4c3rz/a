local FeatureWindow = {}
function FeatureWindow:CreateTab(name, icon)
    local tab = Window:MakeTab({Name = name, Icon = "rbxassetid://4483345998", PremiumOnly = false})
    local out = {}

    function out:CreateSection(name)
        return tab:AddSection({Name = name})
    end

    function out:CreateToggle(opts)
        return tab:AddToggle({
            Name = opts.Name or "Toggle",
            Default = opts.CurrentValue == true,
            Callback = opts.Callback or function() end
        })
    end

    function out:CreateButton(opts)
        return tab:AddButton({Name = opts.Name or "Button", Callback = opts.Callback or function() end})
    end

    function out:CreateInput(opts)
        return tab:AddTextbox({
            Name = opts.Name or "Input",
            Default = tostring(opts.CurrentValue or ""),
            TextDisappear = false,
            Callback = opts.Callback or function() end
        })
    end

    function out:CreateSlider(opts)
        local range = opts.Range or {0, 100}
        return tab:AddSlider({
            Name = opts.Name or "Slider",
            Min = range[1],
            Max = range[2],
            Default = opts.CurrentValue or range[1],
            Increment = opts.Increment or 1,
            ValueName = opts.Suffix or "",
            Callback = opts.Callback or function() end
        })
    end

    function out:CreateDropdown(opts)
        local default = opts.CurrentOption
        if type(default) == "table" then default = default[1] end
        local control = tab:AddDropdown({
            Name = opts.Name or "Dropdown",
            Default = default,
            Options = opts.Options or {},
            Callback = function(value)
                local normalized = type(value) == "table" and value or {value}
                return (opts.Callback or function() end)(normalized)
            end
        })
        return control
    end

    function out:CreateColorPicker(opts)
        return tab:AddColorpicker({
            Name = opts.Name or "Color",
            Default = opts.Color or Color3.new(1, 1, 1),
            Callback = opts.Callback or function() end
        })
    end

    function out:CreateParagraph(opts)
        return tab:AddParagraph({Title = opts.Title or "", Content = opts.Content or ""})
    end

    function out:CreateKeybind(opts)
        local default = opts.CurrentKeybind or "Z"
        return tab:AddBind({
            Name = opts.Name or "Keybind",
            Default = Enum.KeyCode[default] or Enum.KeyCode.Z,
            Hold = opts.HoldToInteract == true,
            Callback = opts.Callback or function() end
        })
    end

    return out
end

