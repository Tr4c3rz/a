local function startAntiGrab()
    antiGrab1T = true

    local char = player.Character or player.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart", 5)

    if not hrp then
        return
    end

    if antiGrabConnection then
        antiGrabConnection:Disconnect()
        antiGrabConnection = nil
    end

    antiGrabConnection = RunService.Heartbeat:Connect(function()
        if not antiGrab1T then
            return
        end

        local isHeld = player:FindFirstChild("IsHeld")

        if isHeld and isHeld.Value then
            if antiGrab1AnchorT then
                hrp.Anchored = true

                while isHeld.Value and antiGrab1T do
                    if struggleRemote then
                        pcall(function()
                            struggleRemote:FireServer(player)
                        end)
                    end

                    task.wait(0.01)
                end

                if hrp and hrp.Parent then
                    hrp.Anchored = false
                end
            else
                while isHeld.Value and antiGrab1T do
                    if struggleRemote then
                        pcall(function()
                            struggleRemote:FireServer(player)
                        end)
                    end

                    task.wait(0.01)
                end
            end
        end
    end)
end

local function stopAntiGrab()
    antiGrab1T = false

    if antiGrabConnection then
        antiGrabConnection:Disconnect()
        antiGrabConnection = nil
    end

    if player.Character then
        local hrp = player.Character:FindFirstChild("HumanoidRootPart")

        if hrp then
