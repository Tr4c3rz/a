local function applyDarkBlueCoreGuiOutline()
    local CoreGui = game:GetService("CoreGui")
    local darkBlue = Color3.fromRGB(0, 0, 100)
    local strokes = {}

    local function register(obj)
        if obj:IsA("UIStroke") then
            table.insert(strokes, obj)
            obj.Color = darkBlue
        end
    end

    local function scan(gui)
        for _, v in ipairs(gui:GetDescendants()) do
            register(v)
        end

        gui.DescendantAdded:Connect(register)
    end

    scan(CoreGui)

    RunService.RenderStepped:Connect(function()
        for i = #strokes, 1, -1 do
            local stroke = strokes[i]

            if stroke and stroke.Parent then
                stroke.Color = darkBlue
            else
                table.remove(strokes, i)
            end
        end
    end)
end

