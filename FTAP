end)

if getrawmetatable and setreadonly then
    local mt = getrawmetatable(game)
    local __index = mt.__index
    local __namecall = mt.__namecall

    setreadonly(mt, false)

    mt.__index = function(self, key)
        if SilentAim.Enabled
            and SilentAim.TargetPart
            and not checkcaller() then

            if self == mouse then
                if key == "Target" then
                    return SilentAim.TargetPart

                elseif key == "Hit" then
                    return SilentAim.TargetPart.CFrame

                elseif key == "Origin" then
                    return camera.CFrame

                elseif key == "UnitRay" then
                    return Ray.new(
                        camera.CFrame.Position,
                        (
                            SilentAim.TargetPart.Position -
                            camera.CFrame.Position
                        ).Unit
                    )
                end
            end
        end

        return __index(self, key)
    end

    mt.__namecall = function(self, ...)
        local method = getnamecallmethod()

        if SilentAim.Enabled
            and SilentAim.TargetPart
            and not checkcaller() then

            if method == "FindPartOnRay"
                or method == "FindPartOnRayWithIgnoreList"
                or method == "FindPartOnRayWithWhitelist" then

                return SilentAim.TargetPart,
                    SilentAim.TargetPart.Position,
                    Vector3.new(0, 1, 0),
                    SilentAim.TargetPart.Material

            elseif method == "Raycast"
                and self == Workspace then

                return {
                    Instance = SilentAim.TargetPart,
                    Position = SilentAim.TargetPart.Position,
                    Material = SilentAim.TargetPart.Material,
                    Normal = Vector3.new(0, 1, 0),
                    Distance = (
                        camera.CFrame.Position -
                        SilentAim.TargetPart.Position
                    ).Magnitude
                }
            end
        end

        return __namecall(self, ...)
    end

    setreadonly(mt, true)
end

if hookfunction and player.GetMouse then
    local oldGetMouse

    oldGetMouse = hookfunction(
        player.GetMouse,
        function(self, ...)
            local result = oldGetMouse(self, ...)

            if SilentAim.Enabled and SilentAim.TargetPart then
                local fakeMouse = {}

                setmetatable(fakeMouse, {
                    __index = function(t, k)
                        if k == "Target" then
                            return SilentAim.TargetPart

                        elseif k == "Hit" then
                            return SilentAim.TargetPart.CFrame

                        elseif k == "Origin" then
                            return camera.CFrame

                        elseif k == "UnitRay" then
                            return Ray.new(
                                camera.CFrame.Position,
                                (
                                    SilentAim.TargetPart.Position -
                                    camera.CFrame.Position
                                ).Unit
                            )
                        end

                        return result[k]
                    end
                })

                return fakeMouse
            end

            return result
        end
    )
end

