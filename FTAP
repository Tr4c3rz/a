local function saveSettings()
    local configData = {
        Flags = Flags,
        ManualWhitelist = manualWhitelist,
        SilentAimEnabled = SilentAim.Enabled
    }

    pcall(function()
        if writefile then
            writefile(SAVE_FILE_NAME, HttpService:JSONEncode(configData))
        end
    end)
end

local function loadSettings()
    local fileExists, content = pcall(function()
        if readfile and isfile and isfile(SAVE_FILE_NAME) then
            return readfile(SAVE_FILE_NAME)
        end
    end)

    if fileExists and content then
        local success, decoded = pcall(function()
            return HttpService:JSONDecode(content)
        end)

        if success and decoded then
            if decoded.Flags then
                for k, v in pairs(decoded.Flags) do
                    if Flags[k] ~= nil then
                        Flags[k] = v
                    end
                end
            end

            if decoded.ManualWhitelist then
                for k, v in pairs(decoded.ManualWhitelist) do
                    local id = tonumber(k) or k
                    manualWhitelist[id] = v
                end
            end

            if decoded.SilentAimEnabled ~= nil then
                SilentAim.Enabled = decoded.SilentAimEnabled
            end

            return true
        end
    end

    return false
end

